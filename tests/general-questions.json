    "q": "Who orders the lumber and by when?",
    "answer_regex": "Maria.{0,160}Nov(ember)?\\.? 15|Nov(ember)?\\.? 15.{0,160}Maria"
   },
   {
    "q": "When is the next meeting?",
    "answer_regex": "Nov(ember)?\\.? 18"
   },
   {
    "q": "What happened with the tool shed?",
